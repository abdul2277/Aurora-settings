{
  "name": "aurora-settings",
  "version": "1.39.0",
  "description": "Aurora Settings - an original, enhanced Settings app for Windows 11",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:linux": "electron-builder --linux AppImage",
    "build:mac": "electron-builder --mac zip",
    "test": "node --test \"test/*.test.js\"",
    "test:ui": "node test/ui-store.js && node test/ui-pages.js && node test/ui-addons.js && node test/ui-drop.js",
    "test:e2e": "xvfb-run -a node test/e2e-smoke.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.aurora.settings",
    "productName": "Aurora Settings",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "Aurora-Settings.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "Aurora-Settings-linux.${ext}",
      "synopsis": "Settings for Aurora OS and Windows",
      "description": "Aurora Settings: tweak, customise and tidy your PC.",
      "maintainer": "Aurora <aurora@aurora-os.invalid>"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "artifactName": "Aurora-Settings-mac-${arch}.${ext}",
      "identity": null
    },
    "asarUnpack": [
      "lib/expander/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aurora Settings",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Aurora Settings",
      "artifactName": "Aurora-Settings-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Aurora-Settings-Portable.${ext}"
    },
    "deb": {
      "artifactName": "Aurora-Settings-linux.${ext}"
    }
  },
  "author": "Aurora",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "yaml": "^2.9.1"
  },
  "homepage": "https://aurora-os.invalid/"
}
